    {
      "type": "timeseries",
      "title": "CPU por contenedor",
      "description": "Núcleos de CPU usados (cAdvisor). 1 = un núcleo completo",
      "id": 12,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 15
